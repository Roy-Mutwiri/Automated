# --- Cross-folder junctions -------------------------------------------------
# Anon/Dripper and Dripper/Anon are Windows directory junctions pointing at
# their sibling folder. They are convenience links for navigating on disk, not
# real content. Git follows them like ordinary directories, so without these
# rules every file would be committed twice and the path loop
# (Anon/Dripper/Anon/...) would recurse until git gave up.
/Anon/Dripper/
/Dripper/Anon/

# --- Auto-sync runtime ------------------------------------------------------
/tools/sync.log

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Model weights and checkpoints ------------------------------------------
# NEVER commit these. GitHub rejects files over 100 MB and the auto-push
# watcher would otherwise try to upload multi-GB checkpoints on every change.
*.pth
*.pt
*.bin
*.safetensors
*.ckpt
*.onnx
*.engine
*.plan
*.trt
*.tflite
*.gguf
*.npz
models/
checkpoints/
weights/
pretrained_weights/
**/models--*/

# --- Generated media --------------------------------------------------------
# Source assets under Anon/assets/ are tracked explicitly (see the ! rules);
# everything rendered at runtime is not.
Anon/output/
Anon/renders/
Anon/captures/
Anon/logs/
*.mp4
*.avi
*.mov
*.mkv
*.wav

# --- Local machine state ----------------------------------------------------
.env
*.local.yaml
.DS_Store
Thumbs.db

# --- Vendored upstream projects ---------------------------------------------
# Cloned from upstream, not our code. Pinned commit recorded in
# Anon/docs/avatar_model_research.md so the environment is reproducible.
Anon/third_party/

# Generated presenter candidates. Reproducible from tools/generate_presenter.py
# with the recorded seed, and ~1.3 MB each, so only the chosen portrait
# (Anon/assets/) is tracked.
Anon/candidates/

# Generated scene candidates. Reproducible from tools/generate_scene.py with the
# recorded seed; only the chosen master frame (Anon/assets/) is tracked.
Anon/scenes/
Anon/candidates_stream/

# --- Rendered clips ---------------------------------------------------------
# A 5-minute 1080p30 render is hundreds of MB, over GitHub's 100 MB per-file
# hard limit, and it is fully reproducible: the behaviour engine is
# deterministic, so `tools/silent_human.py --seed N` reproduces the exact same
# performance frame for frame. The evidence derived from it - timeline, metrics,
# screenshots, inspection sheets - IS tracked, because that is what a reviewer
# needs and what a diff can show.
Anon/*.mp4
Anon/silent_render.log

# LHM remote reconstruction sandbox — licence-restricted and large artefacts
Anon/research/lhm_remote/private_models/
Anon/research/lhm_remote/outputs/
Anon/research/lhm_remote/LHM/
Anon/research/avatar_reconstruction/env/

Anon/body_frames/
Anon/body_render.log

# Per-worktree sync watcher artefacts (tools/sync.ps1)
.sync-message
tools/sync-*.log

# Generated output, brought forward from main so this branch matches it.
#
# camera-terminal forked from main at 25a1a0d, before these rules were added,
# so its .gitignore was 17 lines behind. Anon/eyehead_frames/ is the one that
# matters: 990 tracked PNGs auto-committed by the old folder-based sync
# watcher before the rule existed. Without this rule here, removing them from
# history would leave them untracked AND unignored on this branch, and the
# next `git add -A` would put all of it straight back.
Anon/eyehead_frames/
Anon/calibration/
Anon/clip_blink.png
Anon/clip_gaze.png
Anon/clip_contact_sheet.png
Anon/seated_frames/
Anon/seated_debug_frames/
Anon/finger_tmp/
Anon/seated_render.log
Anon/seated_debug.log
Anon/humanity_frames/
Anon/salience_frames/
Anon/avatar_vis_frames/
Anon/*.log
