# Copy to .env and fill in. NEVER commit .env.

# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-...
GOLD_MODEL_GENERATION=claude-opus-5
GOLD_MODEL_CLASSIFY=claude-haiku-4-5

# --- Infrastructure (not needed for the M1 dry run) ---
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://gold:gold@localhost:5432/goldlive

# --- Market data (M2) ---
MARKET_FEED_PROVIDER=mock
MARKET_FEED_API_KEY=

# --- TTS (M4) ---
TTS_PROVIDER=file
TTS_API_KEY=

# --- Safety ---
# Hard ceiling on how stale market data may be before price quoting is disabled.
MARKET_STALE_AFTER_MS=15000
