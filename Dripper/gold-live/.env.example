# Copy to .env and fill in. NEVER commit .env.

# --- Local LLM (the default and the design intent) -------------------------
# Any OpenAI-compatible server: vLLM, llama.cpp server, Ollama, TGI, SGLang.
#
#   vLLM     vllm serve <model> --port 8000 --enable-prefix-caching
#            LLM_BASE_URL=http://127.0.0.1:8000/v1
#   Ollama   ollama serve
#            LLM_BASE_URL=http://127.0.0.1:11434/v1
#
# --enable-prefix-caching matters: each session's persona prompt is identical
# on every request and must not be reprocessed each time.
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=local-model
LLM_API_KEY=not-needed

# Benchmark before committing to hardware:
#   python -m scripts.bench_llm

# --- Hosted API (A/B comparison only, NOT the default) ---------------------
# Useful to measure how far the local model is from a frontier one on the same
# prompts. Not intended for production here -- 7 sessions x 24/7 would cost
# thousands a month.
ANTHROPIC_API_KEY=

# --- Infrastructure (not needed for the M1 dry run) ------------------------
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://gold:gold@localhost:5432/goldlive

# --- Market data (M2) ------------------------------------------------------
MARKET_FEED_PROVIDER=mock
MARKET_FEED_API_KEY=

# --- TTS (M4) --------------------------------------------------------------
# Local options worth benchmarking on the same box: Piper (fast, modest
# quality), XTTS / StyleTTS2 (better, heavier). Measure time-to-first-audio,
# not MOS.
TTS_PROVIDER=file
TTS_API_KEY=

# --- Safety ----------------------------------------------------------------
# Hard ceiling on how stale market data may be before price quoting is disabled.
MARKET_STALE_AFTER_MS=15000
